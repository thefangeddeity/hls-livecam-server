#!/bin/bash
set -e
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
RED='\033[0;31m'
NC='\033[0m'
# --- Ensure www-data is in video group --------------------------
usermod -aG video www-data

# --- Install pyfakewebcam via pip -------------------------------
if ! python3 -c "import pyfakewebcam" 2>/dev/null; then
    python3 -m pip --version >/dev/null 2>&1 || apt install -y python3-pip
    python3 -m pip install pyfakewebcam --break-system-packages --quiet 2>/dev/null || \
    python3 -m pip install pyfakewebcam --quiet || true
fi

# --- Patch pyfakewebcam tostring() -> tobytes() -----------------
python3 - << 'INNEREOF'
import glob
patterns = [
    '/usr/local/lib/python3*/dist-packages/pyfakewebcam/pyfakewebcam.py',
    '/usr/lib/python3*/dist-packages/pyfakewebcam/pyfakewebcam.py',
    '/usr/local/lib/python3*/site-packages/pyfakewebcam/pyfakewebcam.py',
]
patched = 0
for pattern in patterns:
    for path in glob.glob(pattern):
        with open(path, 'r') as f:
            src = f.read()
        if 'tostring()' in src:
            src = src.replace('tostring()', 'tobytes()')
            with open(path, 'w') as f:
                f.write(src)
            print(f'  patched: {path}')
            patched += 1
        else:
            print(f'  already OK: {path}')
if patched == 0 and not any(glob.glob(p) for p in patterns):
    print('  pyfakewebcam not yet installed -- tobytes fix will apply on next run')
INNEREOF

# --- Persistent config directory --------------------------------
mkdir -p /etc/hls-livecam
chmod 755 /etc/hls-livecam

# --- State directory --------------------------------------------
mkdir -p /var/lib/hls-livecam
chmod 755 /var/lib/hls-livecam

# --- Web root ---------------------------------------------------
mkdir -p /var/www/hls-livecam
chown root:www-data /var/www/hls-livecam
chmod 775 /var/www/hls-livecam

# --- Install the served viewer from the packaged copy ------------
# Until 6.0.0 the deb shipped /var/www/hls-livecam/index.html as payload
# AND /usr/share/hls-livecam-server/index.html as the source the setup
# wizard copies from. Two copies of the same file, and only one of them
# was ever updated: the payload copy sat at a May build (32 KB, pre-CV,
# pre-panel) while the share copy grew to 104 KB. Installing the deb
# would therefore have REPLACED a current viewer with a five-month-old
# one -- the exact failure the packaging is supposed to prevent.
#
# The payload copy is gone. /usr/share is the single source, and this
# step puts it where nginx serves it, on install and on upgrade both, so
# an upgrade actually refreshes the viewer instead of leaving new code
# behind an old page. The sed is a no-op on current viewers (the
# placeholder was retired when the header started reading /api/info) and
# is kept for older ones.
SHARE_VIEWER=/usr/share/hls-livecam-server/index.html
WEB_VIEWER=/var/www/hls-livecam/index.html
if [ -f "$SHARE_VIEWER" ]; then
    cp "$SHARE_VIEWER" "$WEB_VIEWER"
    sed -i "s/@HOSTNAME@/$(hostname)/g" "$WEB_VIEWER"
    chown root:www-data "$WEB_VIEWER"
    chmod 0644 "$WEB_VIEWER"
fi
# The viewer asks for /brand.png in its header. Nothing ever copied it into
# the web root, so it worked only on nodes where someone had done it by hand.
if [ -f /usr/share/hls-livecam-server/brand.png ]; then
    cp /usr/share/hls-livecam-server/brand.png /var/www/hls-livecam/brand.png
    chown root:www-data /var/www/hls-livecam/brand.png
    chmod 0644 /var/www/hls-livecam/brand.png
fi

# --- Rescue cams.json across the v5.2.3 payload eviction ---------
# v5.2.2 and earlier shipped a seed cams.json in the deb payload, which
# dpkg silently overwrote on every install/upgrade (the long-parked
# "cams.json keeps getting wiped" bug). v5.2.3 stops shipping it; preinst
# stashed the live file (if any) before dpkg could delete it as a
# payload file that vanished from the new package. Restore it here if
# it didn't survive the upgrade on its own.
SAVE=/var/lib/hls-livecam/cams.json.upgrade-save
LIVE=/var/www/hls-livecam/cams/cams.json
if [ -f "$SAVE" ]; then
    if [ ! -f "$LIVE" ]; then
        cp -p "$SAVE" "$LIVE"
        chown root:www-data "$LIVE"
        chmod 0664 "$LIVE"
    fi
    rm -f "$SAVE"
fi

# --- mediamtx.yml directory -------------------------------------
mkdir -p /usr/local/etc
if [ -f /usr/local/etc/mediamtx.yml ]; then
    chown root:root /usr/local/etc/mediamtx.yml
fi

# --- sudoers drop-ins -------------------------------------------
# Fix ownership on the ones that are here, and SAY SO when one is not.
# These are written by hls-livecam-setup, not by dpkg, so this script
# cannot recreate them -- it does not know which user to grant. Until
# run-21 the prerm deleted them on every upgrade and this loop silently
# skipped the gap, which is how a node ended up needing `sudo camdash`
# to see its own disk. Silence was the bug; the guard in prerm is the fix.
MISSING_SUDOERS=""
for f in /etc/sudoers.d/hls-livecam-dark \
         /etc/sudoers.d/hls-livecam-services \
         /etc/sudoers.d/camdash-smart; do
    if [ -f "$f" ]; then
        chown root:root "$f"
        chmod 440 "$f"
    else
        MISSING_SUDOERS="$MISSING_SUDOERS $(basename "$f")"
    fi
done
if [ -n "$MISSING_SUDOERS" ]; then
    echo ""
    echo -e "${YELLOW}Missing sudoers drop-ins:${NC}$MISSING_SUDOERS"
    echo "  Without them camdash cannot read SMART and the dark/service"
    echo "  controls will prompt for a password. Run: sudo hls-livecam-setup"
fi

# --- Bring back what prerm stopped -------------------------------
# prerm stops mediamtx and broadcast-api on upgrade, because their files are
# about to be replaced underneath them. Nothing ever started them again, so
# every deb upgrade left the node dark until a human noticed -- the same
# silence as the sudoers bug, one script further along.
#
# Only units that are ENABLED get started: a node that deliberately disabled
# something must not have it switched back on by an upgrade. ffmpeg-cam is
# included for the nodes that still use it; on a studio-pipeline node it is
# disabled and stays that way.
if [ -n "$2" ]; then     # $2 is the old version -- set only on upgrade
    for unit in mediamtx broadcast-api ffmpeg-cam; do
        if systemctl is-enabled "$unit" >/dev/null 2>&1; then
            systemctl start "$unit" 2>/dev/null || \
                echo -e "${YELLOW}Could not start $unit -- check: systemctl status $unit${NC}"
        fi
    done
fi

echo ""
echo -e "${GREEN}hls-livecam-server installed.${NC}"
echo ""
echo "Run the setup wizard to configure your webcam:"
echo ""
echo -e "  ${YELLOW}sudo hls-livecam-setup${NC}"
echo ""
