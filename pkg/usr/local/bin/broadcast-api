#!/usr/bin/env python3
"""
broadcast-api -- hls-livecam-server studio pipeline + message/dark/buzz endpoints

Studio model: pyfakewebcam writes frames to v4l2loopback (/dev/video10).
Publisher ffmpeg reads from loopback, pushes to mediamtx. Non-blocking.
"""
from flask import Flask, request, abort
import os, subprocess, time, sys, threading, signal
import numpy as np
import pyfakewebcam
sys.path.insert(0, '/usr/share/hls-livecam-server')
import cv_processor as _cvp
import cv2 as _cv2
import json as _json

# Guarded, deliberately: cv_scene is only needed by the scene-reregister
# endpoint, which is inert unless a node has opted into CV_SCENE_ENABLED.
# An unguarded import here would take the whole studio pipeline down --
# no camera, no stream -- if the module were ever missing (partial
# upgrade, or an older package that predates it). A feature nothing on
# this node uses must not be able to kill the feed.
try:
    import cv_scene as _cvs
except Exception:
    _cvs = None

app = Flask(__name__)

BROADCAST_FILE  = "/var/www/hls-livecam/broadcast.txt"
BUZZ_FILE       = "/var/www/hls-livecam/buzz.txt"
DARK_FLAG       = "/var/lib/hls-livecam/dark"
LOCK_FILE       = "/var/lib/hls-livecam/msg_lock"
FEED_MODE_FILE  = "/var/lib/hls-livecam/feed_mode"
FOVEAL_MODE_FILE = "/var/lib/hls-livecam/foveal_mode"

# The one default in this system where the wrong value has a real-world
# consequence: this is a privacy control on a camera pointed at a family's
# living space. A restart previously reset it to 'show', exposing the clear
# camera even though the operator had deliberately chosen cloak -- observed
# twice in one run. CV is the safe default when no prior state exists;
# 'show' is never assumed.
SAFE_FEED_MODE  = 'cv'
VALID_MODES     = ('show', 'cv', 'hide')
# CV Mode pivot (SPEC fleet contract): 'cloak' was the pre-pivot name for
# this mode. Every node in the fleet talks to every other node's endpoints
# and will not ship the pivot on the same day, so this alias is accepted on
# input indefinitely -- not just through a transition window.
MODE_ALIASES    = {'cloak': 'cv'}

def _normalize_mode(val):
    return MODE_ALIASES.get(val, val)

MAX_LEN         = 120
DEVICE_ENV      = '/etc/hls-livecam/device.env'
LOOPBACK_DEVICE = '/dev/video10'
FRAME_W         = 1280
FRAME_H         = 720
FRAME_BYTES     = FRAME_W * FRAME_H * 3
_cam_proc = None
_pub_proc = None
# Set once _writer_loop constructs it -- the scene-reregister endpoint
# (CV Mode Phase 3) needs to reach into the live CVProcessor instance from
# a Flask request handler, which runs on a different thread than the
# writer loop that owns it.
_cv_proc = None
# Set the instant SIGTERM arrives. Both supervisor loops respawn any child
# they find dead, so without this they immediately undo _shutdown()'s work:
# the replacement ffmpeg then outlives the interpreter, the unit's cgroup
# never empties, and systemd waits out its full stop timeout before SIGKILL
# -- leaving the unit 'failed' and an ffmpeg still holding the camera.
_shutting_down = threading.Event()

def _read_device_env():
    env = {}
    try:
        with open(DEVICE_ENV) as f:
            for line in f:
                line = line.strip()
                if line and not line.startswith('#') and '=' in line:
                    k, v = line.split('=', 1)
                    env[k] = v
    except Exception:
        pass
    return env

# -- Mode state --
def _read_feed_mode():
    """Last deliberate mode, or the safe default. Never 'show' by fallback."""
    try:
        with open(FEED_MODE_FILE) as f:
            val = _normalize_mode(f.read().strip())
        if val in VALID_MODES:
            return val
    except Exception:
        pass
    return SAFE_FEED_MODE

def _write_feed_mode(mode):
    try:
        os.makedirs(os.path.dirname(FEED_MODE_FILE), exist_ok=True)
        with open(FEED_MODE_FILE, 'w') as f:
            f.write(mode)
    except Exception:
        pass

# Foveal Layer (CV Mode Phase 1). A modifier on CV Mode, not a mode of its
# own -- same shape as feed mode itself: persisted state file, safe default
# (off), GET/POST. Unlike every other CV_* knob, this is checked live every
# writer-loop iteration (see cv_proc.set_foveal() below) rather than only
# read once at CVProcessor construction -- so the checkbox in each UI
# actually behaves like feed mode's buttons, not like a device.env key that
# needs a restart to take effect.
def _read_foveal_mode():
    try:
        with open(FOVEAL_MODE_FILE) as f:
            return f.read().strip() == 'true'
    except Exception:
        return False

def _write_foveal_mode(enabled):
    try:
        os.makedirs(os.path.dirname(FOVEAL_MODE_FILE), exist_ok=True)
        with open(FOVEAL_MODE_FILE, 'w') as f:
            f.write('true' if enabled else 'false')
    except Exception:
        pass

_foveal_enabled = _read_foveal_mode()
_foveal_lock    = threading.Lock()

_mode      = _read_feed_mode()
_mode_lock = threading.Lock()
try:
    with open(LOCK_FILE) as _f: _msg_lock = _f.read().strip() == "true"
except FileNotFoundError: _msg_lock = True
_hide_frame     = None

# -- Camera frame cache --
_cam_frame      = None
_cam_frame_lock = threading.Lock()

# Hide publishes a black frame. Matches the Windows node, whose hide_command
# is `-f lavfi -i color=black:s=1280x720:r=30` -- viewers get a blank screen
# and the viewer UI says so politely, rather than being shown something that
# looks like a fault.
#
# Replaces _apply_svhs_warp(), which row-shuffled and horizontally rolled the
# *live camera frame*: the torn-scanline look reported in run-6 was real image
# content, not noise. A black frame is derived from nothing at all.
#
# The VHS static that Windows shows belongs to feed *transitions*, not to
# Hide, and is drawn client-side by the viewer -- see index.html's
# drawStatic(). Nothing generates it here.
_BLACK_FRAME = None

def _render_hide_frame(width, height):
    """Black frame, allocated once and reused."""
    global _BLACK_FRAME
    if _BLACK_FRAME is None or _BLACK_FRAME.shape[:2] != (height, width):
        _BLACK_FRAME = np.zeros((height, width, 3), dtype=np.uint8)
    return _BLACK_FRAME

def _start_loopback_publisher(denv):
    fr = int(denv.get('FRAMERATE', 15))
    # Keyframe interval, in seconds of video. mediamtx can only cut a segment
    # at a keyframe, so this is what actually determines segment length: at
    # GOP 4s the configured 1s hlsSegmentDuration is silently ignored and the
    # manifest reports TARGETDURATION:4, which is where the viewer's live-edge
    # lag comes from.
    #
    # Run-1 established 1s and verified it live. It was lost because the fix
    # was applied to the installed file and never mirrored here, so the next
    # package install overwrote it. Sourced from device.env now so it can be
    # retuned without editing code, and committed here so it survives.
    gop_seconds = int(denv.get('GOP_SECONDS', 1))
    return subprocess.Popen([
        'ffmpeg', '-hide_banner', '-loglevel', 'error',
        '-f', 'v4l2', '-i', LOOPBACK_DEVICE,
        '-c:v', 'libx264', '-preset', 'ultrafast', '-tune', 'zerolatency',
        '-vf', f'fps={fr},format=yuv420p',
        '-profile:v', 'high', '-level', '4.0',
        '-b:v', '1500k', '-g', str(max(1, fr * gop_seconds)),
        '-rtsp_transport', 'tcp', '-f', 'rtsp', 'rtsp://127.0.0.1:8554/cam'
    ], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

def _start_cam_reader(denv):
    device = denv.get('VIDEO_DEVICE', '/dev/video0')
    fr     = int(denv.get('FRAMERATE', 15))
    fmt    = denv.get('V4L2_INPUT_FMT', '-input_format mjpeg').split()[-1]
    return subprocess.Popen([
        'ffmpeg', '-hide_banner', '-loglevel', 'error',
        '-f', 'v4l2', '-input_format', fmt,
        '-video_size', f'{FRAME_W}x{FRAME_H}',
        '-framerate', str(fr),
        '-i', device,
        '-f', 'rawvideo', '-pix_fmt', 'rgb24',
        'pipe:1'
    ], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)

def _drain_loop(cam_holder, denv):
    global _cam_frame, _cam_proc
    while not _shutting_down.is_set():
        try:
            raw = cam_holder[0].stdout.read(FRAME_BYTES)
            if len(raw) == FRAME_BYTES:
                with _cam_frame_lock:
                    _cam_frame = raw
            else:
                time.sleep(2.0)
                if _shutting_down.is_set():
                    return
                cam_holder[0].terminate()
                cam_holder[0] = _start_cam_reader(denv)
                _cam_proc = cam_holder[0]
        except Exception:
            if _shutting_down.is_set():
                return
            time.sleep(1.0)

def _writer_loop():
    global _hide_frame
    denv  = _read_device_env()
    fr    = int(denv.get('FRAMERATE', 15))
    delay = 1.0 / fr

    subprocess.run(['sudo', '-n', '/bin/systemctl', 'stop', 'ffmpeg-cam'],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    time.sleep(0.5)

    # Init loopback writer before publisher so ffmpeg can connect
    loop_cam = pyfakewebcam.FakeWebcam(LOOPBACK_DEVICE, FRAME_W, FRAME_H)

    global _cam_proc, _pub_proc
    cam_holder = [_start_cam_reader(denv)]
    _cam_proc = cam_holder[0]
    threading.Thread(target=_drain_loop, args=(cam_holder, denv), daemon=True).start()

    pub_holder = [_start_loopback_publisher(denv)]
    _pub_proc = pub_holder[0]
    time.sleep(1.0)

    global _cv_proc
    cv_proc = _cvp.CVProcessor(denv)
    _cv_proc = cv_proc
    prev_mode = None
    while not _shutting_down.is_set():
        with _mode_lock:
            mode = _mode

        if pub_holder[0].poll() is not None:
            if _shutting_down.is_set():
                return
            pub_holder[0] = _start_loopback_publisher(denv)
            _pub_proc = pub_holder[0]
            time.sleep(0.5)

        try:
            with _cam_frame_lock:
                raw = _cam_frame
            if raw is None:
                time.sleep(delay)
                continue

            if mode == 'show':
                frame_arr = np.frombuffer(raw, np.uint8).reshape(FRAME_H, FRAME_W, 3)
            elif mode == 'cv':
                # Stays in NumPy/OpenCV array form throughout -- no PNG/PIL
                # round trip. That cycle is what the old cloak render did,
                # and it measured ~190ms/frame here against a 66.7ms budget.
                raw_arr = np.frombuffer(raw, np.uint8).reshape(FRAME_H, FRAME_W, 3)
                with _foveal_lock:
                    cv_proc.set_foveal(_foveal_enabled)
                frame_arr, _cv_meta = cv_proc.process(raw_arr)
            else:  # hide
                frame_arr = _render_hide_frame(FRAME_W, FRAME_H)
            prev_mode = mode

            loop_cam.schedule_frame(frame_arr)

        except Exception:
            time.sleep(0.1)
            continue

        time.sleep(delay)

threading.Thread(target=_writer_loop, daemon=True).start()

# CV Mode pivot: the standalone B&W control is gone (SPEC §1-2). The route
# stays routable -- older clients on other fleet nodes still call it -- but
# is now a permanent no-op reporting the disabled state. No stored state:
# there is nothing left for a toggle to flip.
@app.route('/api/bw-mode', methods=['GET'])
def bw_mode_get():
    return 'false', 200

@app.route('/api/bw-mode', methods=['POST'])
def bw_mode_post():
    return 'false', 200

@app.route('/api/feed-mode', methods=['GET'])
def feed_mode_get():
    with _mode_lock:
        return _mode, 200

@app.route('/api/feed-mode', methods=['POST'])
def feed_mode_post():
    global _mode
    new_mode = _normalize_mode(request.get_data(as_text=True).strip())
    if new_mode not in VALID_MODES:
        abort(400)
    with _mode_lock:
        _mode = new_mode
    # Persist immediately: a mode set by the operator must survive a restart,
    # a crash, or a package upgrade.
    _write_feed_mode(new_mode)
    return new_mode, 200

@app.route('/api/foveal-mode', methods=['GET'])
def foveal_mode_get():
    with _foveal_lock:
        return ('true' if _foveal_enabled else 'false'), 200

@app.route('/api/foveal-mode', methods=['POST'])
def foveal_mode_post():
    global _foveal_enabled
    val = request.get_data(as_text=True).strip().lower()
    if val not in ('true', 'false'):
        abort(400)
    enabled = val == 'true'
    with _foveal_lock:
        _foveal_enabled = enabled
    # Persist immediately, same reasoning as feed mode: a checkbox state the
    # operator set must survive a restart or crash, not silently reset to
    # the safe default.
    _write_foveal_mode(enabled)
    return ('true' if enabled else 'false'), 200

# Reference-image scene model (CV Mode Phase 3). Three-state surfacing --
# registered / stale / unregistered -- read directly off the live
# CVProcessor instance, no separate state to keep in sync.
@app.route('/api/scene-status', methods=['GET'])
def scene_status_get():
    cv_proc = _cv_proc
    if cv_proc is None or not getattr(cv_proc, '_scene_enabled', False) \
            or not getattr(cv_proc, '_scene_registered', False):
        state = 'unregistered'
    elif getattr(cv_proc, '_scene_stale', False):
        state = 'stale'
    else:
        state = 'registered'
    return {'state': state, 'regions': len(getattr(cv_proc, '_scene_regions', []) or [])}, 200

@app.route('/api/scene-reregister', methods=['POST'])
def scene_reregister_post():
    """Grab a fresh frame from this node's own camera, re-match against the
    ALREADY-STORED reference photo, recompute the homography. Accept only
    if the inlier ratio clears CV_SCENE_REREGISTER_MIN_INLIER_RATIO --
    otherwise the existing registration is kept untouched and the response
    reports failure with the real ratio, never a bare OK/fail. A
    confidently wrong registration is worse than none."""
    cv_proc = _cv_proc
    if _cvs is None:
        return {'accepted': False, 'inlier_ratio': 0.0,
                'error': 'cv_scene module not installed on this node'}, 501
    if cv_proc is None or not getattr(cv_proc, '_scene_registered', False):
        return {'accepted': False, 'inlier_ratio': 0.0,
                'error': 'no existing scene model to re-register against'}, 400

    with _cam_frame_lock:
        raw = _cam_frame
    if raw is None:
        return {'accepted': False, 'inlier_ratio': 0.0,
                'error': 'no live camera frame available yet'}, 503

    live_frame = np.frombuffer(raw, np.uint8).reshape(FRAME_H, FRAME_W, 3)
    live_gray = _cv2.cvtColor(live_frame, _cv2.COLOR_RGB2GRAY)

    H, inlier_ratio, n_matches = _cvs.compute_homography(
        cv_proc._scene_reference_gray, live_gray)

    if H is None or inlier_ratio < cv_proc._scene_reregister_min_inlier_ratio:
        return {
            'accepted': False,
            'inlier_ratio': round(inlier_ratio, 3),
            'n_matches': n_matches,
            'error': 'inlier ratio below CV_SCENE_REREGISTER_MIN_INLIER_RATIO '
                     f'({cv_proc._scene_reregister_min_inlier_ratio}) -- '
                     'existing registration kept',
        }, 200

    new_regions = _cvs.rewarp_regions(cv_proc._scene_regions, H)
    cv_proc._scene_homography = H
    cv_proc._scene_regions = new_regions
    cv_proc._scene_stale = False

    try:
        with open(cv_proc._scene_reference_path) as f:
            model = _json.load(f)
        model['homography'] = H.tolist()
        model['regions'] = new_regions
        model['inlier_ratio'] = round(inlier_ratio, 3)
        with open(cv_proc._scene_reference_path, 'w') as f:
            _json.dump(model, f, indent=2)
    except Exception as exc:
        print(f"CV SCENE: re-register succeeded in memory but failed to persist "
              f"to {cv_proc._scene_reference_path}: {type(exc).__name__}: {exc}",
              flush=True)

    print(f"CV SCENE: re-registered, inlier_ratio={inlier_ratio:.3f} "
          f"n_matches={n_matches}", flush=True)
    return {'accepted': True, 'inlier_ratio': round(inlier_ratio, 3),
            'n_matches': n_matches}, 200

@app.route('/api/broadcast', methods=['POST'])
def broadcast():
    body = request.get_data(as_text=True)
    msg  = body.strip()[:MAX_LEN]
    try:
        with open(BROADCAST_FILE, 'w') as f:
            f.write(msg)
        return '', 204
    except PermissionError:
        abort(403)
    except Exception:
        abort(500)

@app.route('/api/dark', methods=['GET'])
def dark_get():
    return ('true' if os.path.exists(DARK_FLAG) else 'false'), 200

@app.route('/api/dark', methods=['POST'])
def dark_post():
    try:
        subprocess.run(
            ['sudo', '-n', 'hls-livecam-dark'],
            timeout=15,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        return ('true' if os.path.exists(DARK_FLAG) else 'false'), 200
    except Exception:
        abort(500)

@app.route('/api/buzz', methods=['POST'])
def buzz_post():
    try:
        ts = str(int(time.time() * 1000))
        with open(BUZZ_FILE, 'w') as f:
            f.write(ts)
        return ts, 200
    except PermissionError:
        abort(403)
    except Exception:
        abort(500)

@app.route('/api/msg-lock', methods=['GET'])
def msg_lock_get():
    return ('true' if _msg_lock else 'false'), 200

@app.route('/api/msg-lock', methods=['POST'])
def msg_lock_post():
    global _msg_lock
    _msg_lock = not _msg_lock
    try:
        with open(LOCK_FILE, 'w') as f: f.write('true' if _msg_lock else 'false')
    except Exception: pass
    return ('true' if _msg_lock else 'false'), 200

@app.route('/api/info', methods=['GET'])
def info():
    import socket, subprocess, re
    hostname = socket.gethostname()
    tailscale = ''
    try:
        out = subprocess.run(['ip', 'addr', 'show'], capture_output=True, text=True).stdout
        m = re.search(r'inet (100\.\d+\.\d+\.\d+)', out)
        if m: tailscale = m.group(1)
    except Exception:
        pass
    return {'hostname': hostname, 'tailscale': tailscale}

def _shutdown(signum, frame):
    """Stop cleanly: no respawns, no surviving children, prompt exit.

    Reaping matters beyond tidiness -- a leaked ffmpeg keeps the v4l2 camera
    and the loopback device open, so the next start finds the device busy.
    """
    _shutting_down.set()

    procs = [p for p in (_pub_proc, _cam_proc) if p is not None]
    for p in procs:
        try:
            p.terminate()
        except Exception:
            pass

    # Give them a moment to go on SIGTERM, then insist. Bounded well inside
    # systemd's stop timeout so the unit stops cleanly rather than being
    # killed and marked failed.
    deadline = time.time() + 5.0
    for p in procs:
        try:
            p.wait(timeout=max(0.0, deadline - time.time()))
        except Exception:
            try:
                p.kill()
                p.wait(timeout=2.0)
            except Exception:
                pass

    # os._exit rather than sys.exit: this runs on the main thread while it is
    # inside the WSGI server's accept loop, and SystemExit raised there is not
    # reliably propagated. The children are already reaped above, so there is
    # nothing left to unwind.
    os._exit(0)

if __name__ == '__main__':
    signal.signal(signal.SIGTERM, _shutdown)
    signal.signal(signal.SIGINT, _shutdown)
    app.run(host='127.0.0.1', port=5000)
