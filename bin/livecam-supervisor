#!/usr/bin/env python3
"""Fleet-portable supervisor for the livecam stack.

Owns exactly two children -- mediamtx and broadcast-api -- and reconciles them
against the persisted enabled flag on a fixed interval. Runs unchanged on
macOS, Windows 11, and Linux; everything platform-specific is in
livecam_platform.

Replaces the bash `livecam-autostart`, which could not run on Windows and which
supervised by calling `livecam start` in a loop. That shelling-out was the
source of a config-reload storm: every pass unconditionally regenerated
mediamtx.yml, mediamtx hot-reloaded on the write, and HLS muxers were torn down
and recreated every two seconds. Here the config is generated once, in-process,
and written only when its content actually changes.

What this deliberately does NOT do is decide whether the box should be
streaming. That is the enabled flag's job, and the flag is a file, so it
survives reboots and reinstalls identically on all three platforms regardless
of how the supervisor itself got started.
"""
import os
import sys
import time
import signal
import subprocess

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import livecam_platform as P

POLL_SECONDS   = 2.0
LOG_MAX_BYTES  = 8 * 1024 * 1024

STATE     = P.state_dir()
LOGS      = P.log_dir()
LOCK_DIR  = os.path.join(STATE, "supervisor.lock")
LOCK_PID  = os.path.join(LOCK_DIR, "pid")
MMTX_PID  = os.path.join(STATE, "mediamtx.pid")
API_PID   = os.path.join(STATE, "broadcast-api.pid")
MMTX_YML  = os.path.join(STATE, "mediamtx.yml")

_stop = False


def log(msg):
    line = f"[{time.strftime('%Y-%m-%d %H:%M:%S')}] {msg}"
    print(line, file=sys.stderr, flush=True)
    try:
        with open(os.path.join(LOGS, "supervisor.log"), "a") as f:
            f.write(line + "\n")
    except Exception:
        pass


def open_log(name):
    """Append handle with size-capped rotation one generation deep.

    Checked on open rather than on a timer: a crash-looping component reopens
    often, which is exactly the case that would otherwise fill the disk. The
    unsupervised version of this stack left a 45 MB broadcast-api.log behind.
    """
    path = os.path.join(LOGS, name)
    try:
        if os.path.exists(path) and os.path.getsize(path) > LOG_MAX_BYTES:
            os.replace(path, path + ".1")
        return open(path, "ab", buffering=0)
    except Exception:
        return subprocess.DEVNULL


# ── Singleton lock ───────────────────────────────────────────────

def acquire_lock():
    """Atomic-mkdir singleton. Reclaims the lock if the recorded owner is gone.

    Duplicate supervisors are not a theoretical concern: several accumulated
    from repeated manual launches on one box, each independently restarting the
    backend, which produced competing mediamtx instances fighting over the RTSP
    port and a stream that flapped between working and 404.
    """
    P.ensure_dirs()
    try:
        os.mkdir(LOCK_DIR)
    except FileExistsError:
        owner = P.read_pidfile(LOCK_PID)
        if owner and owner != os.getpid() and P.pid_alive(owner):
            log(f"another supervisor is already running (pid {owner}); exiting")
            return False
        log("reclaiming stale supervisor lock")
        try:
            if os.path.exists(LOCK_PID):
                os.remove(LOCK_PID)
            os.rmdir(LOCK_DIR)
            os.mkdir(LOCK_DIR)
        except Exception:
            log("could not reclaim lock; exiting")
            return False
    P.write_pidfile(LOCK_PID, os.getpid())
    return True


def release_lock():
    try:
        if os.path.exists(LOCK_PID):
            os.remove(LOCK_PID)
        os.rmdir(LOCK_DIR)
    except Exception:
        pass


# ── mediamtx config ──────────────────────────────────────────────

def render_mediamtx_yml(cfg):
    return f"""# Generated by livecam-supervisor - do not edit; regenerated on change.
logLevel: info
logDestinations: [stdout]

api: no
metrics: no
pprof: no
playback: no
rtmp: no
webrtc: no
srt: no

rtsp: yes
rtspTransports: [tcp]
rtspAddress: :{cfg.get('RTSP_PORT', '8554')}

hls: yes
hlsAddress: :{cfg.get('HLS_PORT', '8888')}
hlsAllowOrigin: '*'
hlsAlwaysRemux: yes
hlsVariant: fmp4
hlsSegmentCount: 7
hlsSegmentDuration: 1s

paths:
  cam:
  all_others:
"""


def write_mediamtx_yml(cfg):
    """Write only on change -- mediamtx watches this file and hot-reloads on
    every write, tearing down live HLS muxers as it does."""
    want = render_mediamtx_yml(cfg)
    try:
        with open(MMTX_YML) as f:
            if f.read() == want:
                return False
    except Exception:
        pass
    tmp = MMTX_YML + ".tmp"
    with open(tmp, "w") as f:
        f.write(want)
        f.flush()
        os.fsync(f.fileno())
    os.replace(tmp, MMTX_YML)      # atomic: mediamtx never sees a partial file
    log("mediamtx.yml updated")
    return True


# ── Component control ────────────────────────────────────────────

def venv_python():
    cand = (os.path.join(P.ROOT, ".venv", "Scripts", "python.exe") if P.IS_WINDOWS
            else os.path.join(P.ROOT, ".venv", "bin", "python"))
    return cand if os.path.exists(cand) else sys.executable


def component_running(pidfile):
    return P.pid_alive(P.read_pidfile(pidfile))


def start_mediamtx(cfg):
    write_mediamtx_yml(cfg)
    proc = subprocess.Popen([P.mediamtx_bin(), MMTX_YML],
                            stdin=subprocess.DEVNULL,
                            stdout=open_log("mediamtx.log"),
                            stderr=subprocess.STDOUT)
    P.write_pidfile(MMTX_PID, proc.pid)
    log(f"started mediamtx (pid {proc.pid})")
    return proc


def start_api():
    proc = subprocess.Popen([venv_python(), P.runtime_bin("broadcast-api")],
                            stdin=subprocess.DEVNULL,
                            stdout=open_log("broadcast-api.log"),
                            stderr=subprocess.STDOUT)
    P.write_pidfile(API_PID, proc.pid)
    log(f"started broadcast-api (pid {proc.pid})")
    return proc


def stop_component(pidfile, name):
    pid = P.read_pidfile(pidfile)
    if pid and P.pid_alive(pid):
        log(f"stopping {name} (pid {pid})")
        P.terminate(pid)
    try:
        os.remove(pidfile)
    except Exception:
        pass


def stop_all():
    stop_component(API_PID, "broadcast-api")
    stop_component(MMTX_PID, "mediamtx")


# ── Reconcile loop ───────────────────────────────────────────────

def reconcile(was_enabled):
    enabled = P.is_enabled()
    if enabled != was_enabled:
        log(f"enabled flag -> {'on' if enabled else 'off'}")

    if not enabled:
        if component_running(MMTX_PID) or component_running(API_PID):
            stop_all()
        return enabled

    cfg = P.read_config()
    if not component_running(MMTX_PID):
        start_mediamtx(cfg)
        time.sleep(1.0)          # let the RTSP listener bind before publishing
    else:
        write_mediamtx_yml(cfg)  # no-op unless the config genuinely changed
    if not component_running(API_PID):
        start_api()
    return enabled


def handle_signal(signum, frame):
    global _stop
    _stop = True


def main():
    P.ensure_dirs()
    if not acquire_lock():
        return 0

    for sig in (signal.SIGTERM, signal.SIGINT):
        try:
            signal.signal(sig, handle_signal)
        except Exception:
            pass

    log(f"supervisor starting (pid {os.getpid()}, platform {sys.platform})")
    was = None
    try:
        while not _stop:
            try:
                was = reconcile(was)
            except Exception as exc:
                log(f"reconcile error: {exc}")
            for _ in range(int(POLL_SECONDS * 10)):
                if _stop:
                    break
                time.sleep(0.1)
    finally:
        log("supervisor stopping; shutting down components")
        stop_all()
        release_lock()
    return 0


if __name__ == "__main__":
    sys.exit(main())
