#!/usr/bin/env python3
"""
broadcast-api -- hls-livecam-server (macOS port)

Studio pipeline + message/dark/buzz endpoints + static web serving.

macOS differences from the Linux original:
  * Camera captured via ffmpeg's avfoundation input, not v4l2.
  * No v4l2loopback / pyfakewebcam. Processed RGB frames are written
    straight into a publisher ffmpeg's stdin (rawvideo pipe), which
    pushes RTSP to mediamtx. No kernel module required.
  * This process also serves the web viewer, /api/*, and the state
    files (broadcast.txt, buzz.txt, dark.png, cams.json) — replacing
    nginx. Everything is on WEB_PORT; no root, no port-80 conflict.
"""
import os, subprocess, time, sys, threading, io, signal, socket, re, shutil
import numpy as np
from PIL import Image
from flask import Flask, request, abort, send_from_directory, Response

# ── Paths (repo-relative, no FHS) ────────────────────────────────
BIN_DIR   = os.path.dirname(os.path.abspath(__file__))
ROOT      = os.path.dirname(BIN_DIR)
WEB_DIR   = os.path.join(ROOT, "web")
STATE_DIR = os.path.join(ROOT, "state")
CONFIG    = os.path.join(ROOT, "config.env")
os.makedirs(STATE_DIR, exist_ok=True)

# Capture ffmpeg's stderr to a real file. It used to go to DEVNULL, which is
# why a capture wedged inside avformat_open_input left no trace anywhere: the
# process stayed alive, the pidfile stayed valid, and every viewer got a 404
# off a stack that looked healthy (observed: 31 minutes, silently).
# When installed, ROOT is inside the read-only .app bundle -- the state dir
# humans actually read (and the one livecam writes broadcast-api.log and
# mediamtx.log into) lives in Application Support. Follow it there.
_IN_BUNDLE = ".app/Contents/Resources/" in BIN_DIR
LOG_DIR = (os.path.expanduser("~/Library/Application Support/HLS Livecam/state/logs")
           if _IN_BUNDLE else os.path.join(STATE_DIR, "logs"))
FFMPEG_LOG     = os.path.join(LOG_DIR, "capture-ffmpeg.log")
FFMPEG_LOG_MAX = 2 * 1024 * 1024
try:
    os.makedirs(LOG_DIR, exist_ok=True)
except Exception:
    pass

sys.path.insert(0, BIN_DIR)
import block_art as _ba

BROADCAST_FILE = os.path.join(STATE_DIR, "broadcast.txt")
BUZZ_FILE      = os.path.join(STATE_DIR, "buzz.txt")
DARK_FLAG      = os.path.join(STATE_DIR, "dark")
LOCK_FILE      = os.path.join(STATE_DIR, "msg_lock")
DARK_PY        = os.path.join(BIN_DIR, "livecam-dark")
MAX_LEN        = 120
GOL_COLS       = 80

# run-13: never invoke ffmpeg by bare name. Under the launchd agent the PATH is
# the launchd default (/usr/bin:/bin:/usr/sbin:/sbin) -- it does NOT include
# /usr/local/bin, where Homebrew's ffmpeg lives. A bare 'ffmpeg' therefore
# raises FileNotFoundError inside the writer thread the moment the pipeline is
# started by the login agent rather than by hand, killing capture outright while
# the Flask side keeps serving happily (observed in broadcast-api.log). Resolve
# once, at import, against PATH and then the known install locations.
# Camera helper inside the installed macOS application bundle.
_CAMERA_HELPER = os.path.normpath(os.path.join(
    os.path.dirname(__file__),
    "..",
    "Helpers",
    "HLS Livecam Camera.app",
    "Contents",
    "MacOS",
    "camera-capture",
))

FFMPEG = (
    shutil.which('ffmpeg')
    or next((p for p in ('/usr/local/bin/ffmpeg',
                         '/opt/homebrew/bin/ffmpeg',
                         '/usr/bin/ffmpeg')
             if os.path.exists(p)), None)
    or 'ffmpeg'
)

# Same PATH hazard as ffmpeg above: under launchd, /usr/sbin is on the default
# PATH, but resolve explicitly rather than betting the watchdog on it.
LSOF = shutil.which('lsof') or '/usr/sbin/lsof'

app = Flask(__name__)


def _read_config():
    env = {}
    try:
        with open(CONFIG) as f:
            for line in f:
                line = line.strip()
                if line and not line.startswith('#') and '=' in line:
                    k, v = line.split('=', 1)
                    # Values are read to EOL, but tolerate an inline "# comment".
                    if '#' in v and k.strip() != 'AVF_DEVICE_NAME':
                        v = v.split('#', 1)[0]
                    env[k.strip()] = v.strip()
    except Exception:
        pass
    return env


_cfg      = _read_config()
FRAME_W, FRAME_H = (int(x) for x in _cfg.get('VIDEO_SIZE', '1280x720').split('x'))
FRAME_BYTES = FRAME_W * FRAME_H * 3
RTSP_PORT   = _cfg.get('RTSP_PORT', '8554')
RTSP_URL    = f"rtsp://127.0.0.1:{RTSP_PORT}/cam"
HLS_PORT    = _cfg.get('HLS_PORT', '8888')

# Blur renderer: 'font' (original, PIL text engine) or 'vector' (run-7 §3).
# Defaults to 'font' so behaviour is unchanged until the PM gates the vectorized
# look -- it drops glyph antialiasing, which is an aesthetic call, not a bug fix.
BLUR_RENDERER = _cfg.get('BLUR_RENDERER', 'vec').strip().lower()

# Keyframe interval in seconds. Must match mediamtx's hlsSegmentDuration.
GOP_SECONDS = float(_cfg.get('GOP_SECONDS', 1))

_cam_proc = None
_pub_proc = None

# ── Pipeline status ──────────────────────────────────────────────
#
# The viewer's audio panel shows a lamp per stage. Three of them sat grey
# forever because nothing server-side ever reported on them, and a permanently
# grey lamp is indistinguishable from a broken one.
#
# The capture stage is reported by the writer loop, which is the only thing
# that knows whether ffmpeg got past opening the devices. It is deliberately
# not inferred from "is the process alive": a capture deadlocked inside
# avformat_open_input is alive, burning CPU, and producing nothing, which is
# the exact failure this stack was losing hours to.
_pipeline_lock  = threading.Lock()
_pipeline_state = {'capture': 'pending', 'detail': 'starting'}


def _set_capture_state(state, detail=''):
    with _pipeline_lock:
        _pipeline_state['capture'] = state
        _pipeline_state['detail']  = detail

# ── Mode state ───────────────────────────────────────────────────
_mode      = 'show'
_mode_lock = threading.Lock()
_bw_mode   = False
try:
    with open(LOCK_FILE) as _f:
        _msg_lock = _f.read().strip() == "true"
except FileNotFoundError:
    _msg_lock = True
_hide_frame = None

# ── Camera frame cache ───────────────────────────────────────────
_cam_frame      = None
_cam_frame_lock = threading.Lock()


def _png_to_raw(png_bytes):
    return Image.open(io.BytesIO(png_bytes)).convert('RGB').tobytes()


def _apply_svhs_warp(arr):
    import math
    rng = np.random.default_rng(42)
    order = rng.permutation(arr.shape[0])
    shuffled = arr[order]
    out = np.empty_like(shuffled)
    for y in range(shuffled.shape[0]):
        shift = int(180 * math.sin(2 * math.pi * y / 120))
        out[y] = np.roll(shuffled[y], shift, axis=0)
    return out


def _start_publisher():
    """Publisher ffmpeg: reads processed RGB frames from stdin, pushes RTSP.

    cloak/hide rendering (block_art, pure PIL) takes ~110-180ms/frame, well
    over the 66ms budget for 15fps -- frames arrive slower than declared and
    irregularly. -framerate alone tells ffmpeg to assume constant-rate
    arrival and stamp every frame as exactly 1/fr regardless of how long it
    actually took, so the encoded clock silently drifts behind real time;
    whenever the writer catches up, a batch of those falsely-cheap-stamped
    frames flushes at once, which plays back as freeze -> speed-through ->
    freeze. -use_wallclock_as_timestamps stamps frames by real arrival time
    instead, and -fps_mode cfr/-r duplicates the last real frame to fill the
    real gaps, giving a steady constant-rate output that actually tracks
    wall-clock time.
    """
    fr = int(_cfg.get('FRAMERATE', 15))
    return subprocess.Popen([
        FFMPEG, '-hide_banner', '-loglevel', 'error',
        '-f', 'rawvideo', '-pix_fmt', 'rgb24',
        '-s', f'{FRAME_W}x{FRAME_H}', '-framerate', str(fr),
        '-use_wallclock_as_timestamps', '1',
        '-i', 'pipe:0',
        '-fps_mode', 'cfr', '-r', str(fr),
        '-c:v', 'libx264', '-preset', 'ultrafast', '-tune', 'zerolatency',
        '-vf', f'format=yuv420p',
        '-profile:v', 'high', '-level', '4.0',
        # GOP length sets the floor on HLS segment duration -- mediamtx can only
        # cut a segment at a keyframe. `-g fr*4` meant a keyframe every 4s, so
        # mediamtx produced 4s segments no matter what hlsSegmentDuration said,
        # and players targeting a short buffer ran dry between arrivals. Keep
        # this in step with mediamtx's hlsSegmentDuration.
        '-b:v', '1500k', '-g', str(max(1, int(fr * GOP_SECONDS))),
        '-rtsp_transport', 'tcp', '-f', 'rtsp', RTSP_URL
    ], stdin=subprocess.PIPE, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def _resolve_avf_index():
    """Resolve the avfoundation index for the camera named in config.env.

    run-13: AVF_VIDEO_INDEX is POSITIONAL, and macOS enumerates Continuity
    Camera devices (a nearby iPhone) into the same list as the built-in camera.
    An iPhone that registers ahead of the built-in one silently turns
    "index 0" into someone's phone -- a family broadcast that switches source
    when a phone walks into the room, and dies when it walks out. Observed on
    this machine: an iPhone registered itself as "Aayah Camera" alongside the
    built-in FaceTime HD Camera.

    So resolve the index from AVF_DEVICE_NAME at open time instead of trusting
    a number written months ago. Falls back to the configured index if the
    named device is absent or the probe fails -- never worse than before.
    """
    want     = _cfg.get('AVF_DEVICE_NAME', '').strip()
    fallback = _cfg.get('AVF_VIDEO_INDEX', '0')
    if not want:
        return fallback
    try:
        out = subprocess.run(
            [FFMPEG, '-hide_banner', '-f', 'avfoundation',
             '-list_devices', 'true', '-i', ''],
            capture_output=True, text=True, timeout=15).stderr
    except Exception:
        return fallback

    in_video = False
    for line in out.splitlines():
        if 'AVFoundation video devices' in line:
            in_video = True
            continue
        if 'AVFoundation audio devices' in line:
            break
        if not in_video:
            continue
        m = re.search(r'\]\s*\[(\d+)\]\s+(.+?)\s*$', line)
        if m and m.group(2) == want:
            if m.group(1) != fallback:
                print(f"broadcast-api: '{want}' is at avfoundation index "
                      f"{m.group(1)}, not the configured {fallback} -- using "
                      f"{m.group(1)} (device list reordered, likely Continuity "
                      f"Camera)", file=sys.stderr, flush=True)
            return m.group(1)

    print(f"broadcast-api: camera '{want}' not found in avfoundation device "
          f"list; falling back to index {fallback}", file=sys.stderr, flush=True)
    return fallback


def _start_cam_reader():
    """Capture raw RGB frames from the macOS camera helper when installed."""
    if os.path.exists(_CAMERA_HELPER):
        return subprocess.Popen(
            [_CAMERA_HELPER],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL
        )

    idx = _resolve_avf_index()
    fr  = int(_cfg.get('FRAMERATE', 15))
    return subprocess.Popen([
        FFMPEG, '-hide_banner', '-loglevel', 'error',
        '-f', 'avfoundation',
        '-framerate', str(fr),
        '-video_size', f'{FRAME_W}x{FRAME_H}',
        '-pixel_format', 'uyvy422',
        '-i', f'{idx}:none',
        '-f', 'rawvideo', '-pix_fmt', 'rgb24',
        '-vf', f'scale={FRAME_W}:{FRAME_H}',
        'pipe:1'
    ], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)


def _drain_loop(cam_holder):
    """Continuously read camera frames into the shared cache; restart on EOF."""
    global _cam_frame, _cam_proc
    while True:
        try:
            raw = cam_holder[0].stdout.read(FRAME_BYTES)
            if len(raw) == FRAME_BYTES:
                with _cam_frame_lock:
                    _cam_frame = raw
            else:
                time.sleep(2.0)
                try:
                    cam_holder[0].terminate()
                except Exception:
                    pass
                cam_holder[0] = _start_cam_reader()
                _cam_proc = cam_holder[0]
        except Exception:
            time.sleep(1.0)



def _start_combined_av_publisher():
    """
    One AVFoundation session for camera + microphone.

    The resulting RTSP track contains:
      video: H.264 1280x720 @ configured FPS
      audio: AAC 48 kHz stereo @ 96 kb/s

    This deliberately bypasses the old Python frame-processing writer
    path. The API server remains alive for control/message endpoints,
    while media capture/publishing is handled by this single process.
    """
    fr = int(_cfg.get('FRAMERATE', 15))
    video_idx = _resolve_avf_index()
    audio_idx = str(
        _cfg.get('AUDIO_DEVICE', 'Built-in Microphone')
    ).strip() or 'Built-in Microphone'

    rtsp_port = str(_cfg.get('RTSP_PORT', '8554')).strip() or '8554'
    rtsp_url = f'rtsp://127.0.0.1:{rtsp_port}/cam'

    cmd = [
        FFMPEG,
        '-hide_banner',
        '-loglevel', 'error',

        '-f', 'avfoundation',
        '-framerate', str(fr),
        '-video_size', f'{FRAME_W}x{FRAME_H}',
        '-pixel_format', 'uyvy422',
        '-use_wallclock_as_timestamps', '1',
        '-i', f'{video_idx}:{audio_idx}',

        '-map', '0:v:0',
        '-map', '0:a:0',

        '-c:v', 'libx264',
        '-preset', 'ultrafast',
        '-tune', 'zerolatency',
        '-vf', 'format=yuv420p',
        '-profile:v', 'high',
        '-level', '4.0',
        '-b:v', '1500k',
        '-g', str(fr),

        '-c:a', 'aac',
        '-b:a', '96k',
        '-ar', '48000',
        '-ac', '2',

        '-rtsp_transport', 'tcp',
        '-f', 'rtsp',
        rtsp_url,
    ]

    print(
        'broadcast-api: combined AV capture: '
        f'video={video_idx} audio={audio_idx} -> {rtsp_url}',
        file=sys.stderr,
        flush=True,
    )

    return subprocess.Popen(
        cmd,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=_open_ffmpeg_log(),
    )


def _open_ffmpeg_log():
    """Append-mode handle for ffmpeg's stderr, rotated one generation deep.

    Checked at launch rather than on a timer: a crash loop relaunches often,
    which is exactly the case that would otherwise run the disk down. Falls
    back to DEVNULL rather than taking the capture down with it -- a missing
    log is a degraded diagnosis, an exception here is a dead stream.
    """
    try:
        if os.path.exists(FFMPEG_LOG) and os.path.getsize(FFMPEG_LOG) > FFMPEG_LOG_MAX:
            os.replace(FFMPEG_LOG, FFMPEG_LOG + '.1')
        return open(FFMPEG_LOG, 'ab', buffering=0)
    except Exception:
        return subprocess.DEVNULL


def _has_rtsp_connection(pid, port):
    """True when `pid` holds an ESTABLISHED TCP socket to the local RTSP port.

    This is the signal that ffmpeg got past opening its AVFoundation input and
    actually reached mediamtx. A hung capture never opens any socket at all.
    """
    try:
        out = subprocess.run(
            [LSOF, '-a', '-p', str(pid), '-i', 'TCP', '-n', '-P'],
            capture_output=True, text=True, timeout=5).stdout
    except Exception:
        return False
    needle = f':{port}'
    return any('ESTABLISHED' in ln and needle in ln for ln in out.splitlines())


def _kill_hard(proc):
    """Terminate, then kill. A capture deadlocked inside avformat_open_input is
    blocked in a mach_msg syscall and will not act on SIGTERM, so don't wait on
    it politely -- give it a second, then SIGKILL.

    Written out rather than looped over (proc.terminate, proc.kill): comparing a
    bound method with `is` builds a fresh object every access and never matches,
    which silently stretched the SIGTERM grace to the SIGKILL timeout.
    """
    try:
        proc.terminate()
    except Exception:
        return
    try:
        proc.wait(timeout=1.0)
        return
    except Exception:
        pass
    try:
        proc.kill()
        proc.wait(timeout=3.0)
    except Exception:
        pass


# Startup-race watchdog tuning. CONNECT_TIMEOUT is a startup budget, not a
# steady-state poll: a healthy capture connects in well under a second.
CONNECT_TIMEOUT  = 5.0
CONNECT_POLL     = 0.5
MAX_FAST_RETRIES = 3
BACKOFF_SECONDS  = 15.0


def _writer_loop():
    """
    Combined macOS A/V publisher.

    One AVFoundation capture session owns both camera and microphone.
    There is no Python raw-video pipe, no second AVFoundation client,
    and no audio publisher competing for a second capture session.
    """
    global _cam_proc, _pub_proc

    failures = 0

    while True:
        try:
            proc = _start_combined_av_publisher()
            _cam_proc = proc
            _pub_proc = proc

            # Startup race guard. ffmpeg's avfoundation input intermittently
            # deadlocks in avformat_open_input when a single session opens both
            # the camera and the microphone: the process stays alive and burns
            # CPU, but never opens its RTSP output, so mediamtx never sees a
            # publisher and viewers get a 404 off a stack that looks healthy
            # from every angle -- the pidfile is valid, and the bare wait()
            # this replaced blocked forever on a process that was never coming
            # back. So confirm the connection actually happened. Only the
            # startup window is polled; once connected we go back to a plain
            # wait() for the rest of the process's life.
            deadline  = time.monotonic() + CONNECT_TIMEOUT
            connected = False
            while time.monotonic() < deadline:
                if proc.poll() is not None:
                    break
                if _has_rtsp_connection(proc.pid, RTSP_PORT):
                    connected = True
                    break
                time.sleep(CONNECT_POLL)

            if not connected:
                failures += 1
                if proc.poll() is None:
                    print(
                        f'broadcast-api: combined AV capture (pid {proc.pid}) '
                        f'never connected to {RTSP_URL} within '
                        f'{CONNECT_TIMEOUT:.0f}s -- hung opening the capture '
                        f'device; killing and relaunching '
                        f'[consecutive failures: {failures}]',
                        file=sys.stderr, flush=True,
                    )
                    _set_capture_state(
                        'fail', 'capture hung opening the camera/microphone')
                    _kill_hard(proc)
                else:
                    print(
                        f'broadcast-api: combined AV capture exited '
                        f'({proc.returncode}) before connecting to {RTSP_URL} '
                        f'[consecutive failures: {failures}]',
                        file=sys.stderr, flush=True,
                    )
                    _set_capture_state(
                        'fail',
                        f'capture exited ({proc.returncode}) before connecting')

                if failures >= MAX_FAST_RETRIES:
                    print(
                        f'broadcast-api: {failures} consecutive capture '
                        f'failures; backing off {BACKOFF_SECONDS:.0f}s. '
                        f'ffmpeg stderr: {FFMPEG_LOG}',
                        file=sys.stderr, flush=True,
                    )
                    time.sleep(BACKOFF_SECONDS)
                else:
                    time.sleep(1.0)
                continue

            failures = 0
            # Connecting proves the AVFoundation session opened both the camera
            # and the microphone: ffmpeg is given -map 0:a:0, so a microphone it
            # could not open would have aborted the process rather than let it
            # reach mediamtx.
            _set_capture_state('ok', 'capture connected')
            print(
                f'broadcast-api: combined AV capture connected to {RTSP_URL} '
                f'(pid {proc.pid})',
                file=sys.stderr, flush=True,
            )

            rc = proc.wait()

            _set_capture_state('fail', f'capture exited ({rc}); restarting')
            print(
                f'broadcast-api: combined AV publisher exited ({rc}); '
                'restarting',
                file=sys.stderr,
                flush=True,
            )

            time.sleep(1.0)

        except Exception as exc:
            print(
                f'broadcast-api: combined AV publisher error: {exc}',
                file=sys.stderr,
                flush=True,
            )
            time.sleep(2.0)


def bw_mode_get():
    return ('true' if _bw_mode else 'false'), 200


@app.route('/api/bw-mode', methods=['POST'])
def bw_mode_post():
    global _bw_mode
    _bw_mode = not _bw_mode
    return ('true' if _bw_mode else 'false'), 200


@app.route('/api/feed-mode', methods=['GET'])
def feed_mode_get():
    with _mode_lock:
        return _mode, 200


@app.route('/api/feed-mode', methods=['POST'])
def feed_mode_post():
    global _mode
    new_mode = request.get_data(as_text=True).strip()
    if new_mode not in ('show', 'cloak', 'hide'):
        abort(400)
    with _mode_lock:
        _mode = new_mode
    return new_mode, 200


@app.route('/api/broadcast', methods=['POST'])
def broadcast():
    body = request.get_data(as_text=True)
    msg  = body.strip()[:MAX_LEN]
    try:
        with open(BROADCAST_FILE, 'w') as f:
            f.write(msg)
        return '', 204
    except Exception:
        abort(500)


@app.route('/api/dark', methods=['GET'])
def dark_get():
    return ('true' if os.path.exists(DARK_FLAG) else 'false'), 200


@app.route('/api/dark', methods=['POST'])
def dark_post():
    try:
        subprocess.run([sys.executable, DARK_PY], timeout=20,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return ('true' if os.path.exists(DARK_FLAG) else 'false'), 200
    except Exception:
        abort(500)


@app.route('/api/buzz', methods=['POST'])
def buzz_post():
    try:
        ts = str(int(time.time() * 1000))
        with open(BUZZ_FILE, 'w') as f:
            f.write(ts)
        return ts, 200
    except Exception:
        abort(500)


@app.route('/api/msg-lock', methods=['GET'])
def msg_lock_get():
    return ('true' if _msg_lock else 'false'), 200


@app.route('/api/msg-lock', methods=['POST'])
def msg_lock_post():
    global _msg_lock
    _msg_lock = not _msg_lock
    try:
        with open(LOCK_FILE, 'w') as f:
            f.write('true' if _msg_lock else 'false')
    except Exception:
        pass
    return ('true' if _msg_lock else 'false'), 200


_pipeline_cache = {'at': 0.0, 'data': None}
_PIPELINE_TTL   = 2.0


def _tcp_open(port, timeout=0.5):
    try:
        with socket.create_connection(('127.0.0.1', int(port)), timeout=timeout):
            return True
    except Exception:
        return False


def _hls_audio_state():
    """('ok'|'fail', has_audio_track) for the local HLS master playlist."""
    try:
        import urllib.request
        url = f'http://127.0.0.1:{HLS_PORT}/cam/index.m3u8'
        with urllib.request.urlopen(url, timeout=1.5) as r:
            if r.status != 200:
                return 'fail', False
            body = r.read(8192).decode('utf-8', 'replace')
        return 'ok', ('TYPE=AUDIO' in body)
    except Exception:
        return 'fail', False


@app.route('/api/pipeline', methods=['GET'])
def pipeline():
    """Per-stage health for the viewer's audio panel.

    Every value here is measured, never assumed. The panel previously lit only
    the HLS lamp because that was the one stage a browser can observe for
    itself; the other three are server-side facts that had no way to reach it.

    Polled by every open viewer, so results are cached briefly -- the lsof and
    socket probes are cheap but not free, and the underlying state does not
    change faster than the cache window.
    """
    now = time.time()
    if _pipeline_cache['data'] and now - _pipeline_cache['at'] < _PIPELINE_TTL:
        return _pipeline_cache['data']

    with _pipeline_lock:
        capture = _pipeline_state['capture']
        detail  = _pipeline_state['detail']

    mediamtx = 'ok' if _tcp_open(RTSP_PORT) else 'fail'

    # RTSP is the publisher's own socket to mediamtx, which is a stronger claim
    # than "the port is listening": it says this capture reached it.
    #
    # Order matters. Testing the process first reports a red lamp during the
    # ordinary startup window, before the writer loop has spawned ffmpeg at
    # all -- a failure indication for a stack that is merely still starting.
    # Defer to the capture stage, which is the thing that knows.
    proc = _pub_proc
    if capture == 'pending':
        rtsp = 'pending'
    elif proc is None or proc.poll() is not None:
        rtsp = 'fail'
    else:
        rtsp = 'ok' if _has_rtsp_connection(proc.pid, RTSP_PORT) else 'fail'

    hls, has_audio = _hls_audio_state()

    data = {
        # The microphone opened iff the capture session did; they are one
        # AVFoundation session and audio is a mapped output stream.
        'mic':      capture,
        'mediamtx': mediamtx,
        'rtsp':     rtsp,
        'hls':      hls,
        'audio_track': has_audio,
        'detail':   detail,
    }
    _pipeline_cache['at']   = now
    _pipeline_cache['data'] = data
    return data


@app.route('/api/info', methods=['GET'])
def info():
    hostname = socket.gethostname()
    tailscale = ''
    try:
        # macOS: tailscale IPs live on a utun interface; ifconfig lists them.
        out = subprocess.run(['ifconfig'], capture_output=True, text=True).stdout
        m = re.search(r'inet (100\.\d+\.\d+\.\d+)', out)
        if m:
            tailscale = m.group(1)
    except Exception:
        pass
    return {'hostname': hostname, 'tailscale': tailscale}


# ── Static web serving (replaces nginx) ──────────────────────────
_NO_CACHE = {
    'Cache-Control': 'no-store, no-cache, must-revalidate, max-age=0',
    'Pragma': 'no-cache',
    'Access-Control-Allow-Origin': '*',
}


def _nocache(resp):
    for k, v in _NO_CACHE.items():
        resp.headers[k] = v
    return resp


@app.route('/broadcast.txt')
def serve_broadcast():
    try:
        with open(BROADCAST_FILE) as f:
            body = f.read()
    except FileNotFoundError:
        body = ''
    return _nocache(Response(body, mimetype='text/plain'))


@app.route('/buzz.txt')
def serve_buzz():
    try:
        with open(BUZZ_FILE) as f:
            body = f.read()
    except FileNotFoundError:
        body = ''
    return _nocache(Response(body, mimetype='text/plain'))


@app.route('/dark.png')
def serve_darkpng():
    path = os.path.join(STATE_DIR, 'dark.png')
    if not os.path.exists(path):
        abort(404)
    return _nocache(send_from_directory(STATE_DIR, 'dark.png'))


@app.route('/cams/cams.json')
def serve_cams_json():
    return _nocache(send_from_directory(os.path.join(WEB_DIR, 'cams'), 'cams.json',
                                        mimetype='application/json'))


@app.route('/')
def serve_index():
    return _nocache(send_from_directory(WEB_DIR, 'index.html'))


@app.route('/cams')
@app.route('/cams/')
def serve_cams():
    return _nocache(send_from_directory(os.path.join(WEB_DIR, 'cams'), 'cams.html'))


@app.route('/<path:path>')
def serve_static(path):
    full = os.path.join(WEB_DIR, path)
    if os.path.isfile(full):
        return _nocache(send_from_directory(WEB_DIR, path))
    abort(404)


def _shutdown(signum, frame):
    for p in (_pub_proc, _cam_proc):
        if p:
            try:
                p.terminate()
            except Exception:
                pass
    sys.exit(0)


if __name__ == '__main__':
    # Media capture/publishing runs independently of the HTTP control plane.
    # One AVFoundation session owns camera + microphone.
    threading.Thread(
        target=_writer_loop,
        daemon=True,
        name='combined-av-publisher',
    ).start()

    app.run(
        host='0.0.0.0',
        port=int(_cfg.get('WEB_PORT', 8080)),
        threaded=True,
    )
