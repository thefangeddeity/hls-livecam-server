# Python
.venv/
__pycache__/
*.pyc

# Runtime state (generated)
state/*.pid
state/logs/
state/enabled
state/mediamtx.yml
state/dark.png
state/dark_orig.png
state/broadcast.txt
state/buzz.txt
state/msg_lock
state/camdash-feed.state
state/cell_aspect

# Rendered from web/index.template.html by livecam-setup.
#
# This rule has no effect: index.html was committed before it was added, and
# .gitignore does not apply to tracked files. It is kept only so the intent is
# on record -- do NOT `git rm --cached` it to "make the ignore work". The
# template is the source of truth; edit that and re-render. Keeping the
# rendered file tracked also means its diffs stay visible in review, which is
# how the audio panel was found missing from the template in the first place.
web/index.html

# Large vendored binary (re-downloadable)
vendor/mediamtx

# Packaged DMGs -- rebuildable from scripts/build-macos-dmg.sh, ~600 MB each
# because they carry the whole venv. These must never reach the remote.
dist/

# Ad-hoc backups taken before risky refactors
.packaging-backup/
.pre-combined-av-backup-*/

# macOS
.DS_Store

# Local Claude Code state
.claude/
web/cams/cams.json
