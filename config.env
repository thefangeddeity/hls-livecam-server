# hls-livecam-server (macOS port) — configuration
# Written by livecam-setup. Consumed by every component.
AVF_VIDEO_INDEX=0
AVF_DEVICE_NAME=FaceTime HD Camera (Built-in)
VIDEO_SIZE=1280x720
FRAMERATE=15

WEB_PORT=8080
RTSP_PORT=8554
HLS_PORT=8888

# Room mic is quiet at source (~-39 dB mean). Gain is applied at capture
# through a limiter; a browser cannot amplify beyond the source level.
AUDIO_GAIN_DB=

# Product identity. The fleet runs two: HLS Livecam (HLSLS) and HLS LightCV
# (HLSLCVS). Which one a node runs is a property of the node, not the
# platform -- amira is a Mac running LightCV.
PRODUCT_NAME=HLS Livecam
PRODUCT_SHORT=HLSLS

# CV mode. Benchmarked at 43.3ms/frame on ariana (i5-6287U, 2 cores) --
# 65% of the 15fps budget, comfortably inside it. The Linux phases ruled out
# automatic floor inference and scene registration on their hardware; that
# does not bear on whether a detector runs here at all, and it does here.
#
# yolov8n.onnx is not shipped -- Ultralytics' weight licensing is unresolved
# and this repo is public. It is a device-local file, same as vendor/mediamtx:
# bring your own to CV_DETECT_MODEL's path (default: Application Support,
# below), gitignored, never committed. Detection degrades to a logged no-op
# if it isn't there, so this default being on costs nothing on a node without
# the file.
CV_DETECT_ENABLED=1
CV_HUD_ENABLED=1
AUDIO_HIGHPASS_HZ=80
AUDIO_DENOISE=sh
