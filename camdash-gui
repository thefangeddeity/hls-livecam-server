#!/usr/bin/env python3
"""
camdash-gui — launcher for the PySide6 operator GUI (run-5).

The gui/ package installs under the shared data directory, not next to this
launcher, so it isn't importable by default -- this puts it on sys.path and
runs it exactly the way `python -m gui.app` would from a checkout.
"""
import sys

sys.path.insert(0, "/usr/share/hls-livecam-server")
from gui.app import main

if __name__ == "__main__":
    sys.exit(main())
